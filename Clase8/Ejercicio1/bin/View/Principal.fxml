<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.collections.FXCollections?>

<VBox xmlns="http://javafx.com/javafx/25"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="controller.PrincipalController"
    spacing="15"
    alignment="CENTER">

    <Label
        fx:id="lblTitulo"
        styleClass="titulo"
        text="Conversor de Monedas"/>

    <Label
        fx:id="lblMonto"
        text="Monto en pesos dominicanos"/>
    
    <TextField
        fx:id="txtMonto"
        promptText="Ingrese el monto"
        maxWidth="200" />

    <Label
        fx:id="lblMonedaDestino"
        text="Moneda destino"/>

    <ComboBox
        fx:id="cmbMonedasDestino"
        promptText="Seleccione una moneda"
        maxWidth="200" >
    </ComboBox>
    
    <HBox spacing="10"
        alignment="CENTER">

        <Button
            fx:id="btnConvertir"
            text="Convertir"
            onAction="#convertir" />

        <Button
            fx:id="btnLimpiar"
            text="Limpiar"
            onAction="#limpiar"  />
    </HBox>

    <Label 
        fx:id="lblResultado"
        text="Resultado:" />

    <Label 
        fx:id="lblMensaje" 
        text="Esperando información..." />

</VBox>